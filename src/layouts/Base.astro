---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import { u } from '../lib/site';


interface Props {
  title: string;
  description?: string;
  current?: string; // path of the current page, for nav highlighting
  sidebar?: boolean;
  toc?: boolean;
  progress?: boolean;
}
const { title, description = 'TISC 2026 writeups and workings by Elodie Ng.', current = '', sidebar = true, toc = false, progress = false } = Astro.props;
const fullTitle = title === 'Home' ? 'Elodie Ng · TISC 2026 Casebook' : `${title} · TISC 2026 Casebook`;
const nav = [
  { href: u(''), label: 'Overview', key: 'home' },
  { href: u('#levels'), label: 'Levels', key: 'levels' },
  { href: u('concepts/'), label: 'Concepts', key: 'concepts' },
  { href: u('about/'), label: 'About', key: 'about' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f4f5f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0f121a" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible+Next:ital,wght@0,400;0,600;0,700;1,400&family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
    />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        {sidebar && (
          <button class="icon-btn menu-btn" type="button" aria-label="Open level list" aria-controls="sidebar" aria-expanded="false" data-drawer-open>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          </button>
        )}
        <a class="brand" href={u('')}>
          <span class="brand-mark" aria-hidden="true">EN</span>
          <span class="brand-text">
            <span class="brand-name">TISC 2026 Casebook</span>
            <span class="brand-sub">Elodie Ng · Levels 1–7</span>
          </span>
        </a>
        <nav class="header-nav" aria-label="Main">
          {nav.map((n) => (
            <a class="nav-link" href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>
          ))}
          <button class="icon-btn" type="button" data-theme-toggle aria-label="Change colour theme" title="Theme: system">
            <svg data-icon="system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="8" /><path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" /></svg>
            <svg data-icon="light" hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg data-icon="dark" hidden viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg>
          </button>
        </nav>
      </div>
      {progress && <div class="progress" aria-hidden="true"></div>}
    </header>

    <div class:list={['shell', { 'no-toc': !toc }]} style={sidebar ? undefined : 'grid-template-columns: minmax(0,1fr)'}>
      {sidebar && <Sidebar current={Astro.url.pathname} />}
      <main id="content">
        <slot />
      </main>
      <slot name="toc" />
    </div>
    {sidebar && <div class="scrim" data-drawer-close></div>}

    <footer class="site-footer">
      <div class="footer-inner">
        <span>TISC 2026 (The InfoSecurity Challenge) writeups by Elodie Ng. <a href="https://www.linkedin.com/in/elodie-ng/" rel="me noopener" target="_blank">LinkedIn</a></span>
        <span>Solved with AI assistance, described on the <a href={u('about/')}>About</a> page.</span>
      </div>
    </footer>

    <dialog class="lightbox" aria-label="Enlarged image"><img alt="" /></dialog>

    <script>
      import '../scripts/ui';
    </script>
  </body>
</html>
