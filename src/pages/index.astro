---
import Base from '../layouts/Base.astro';
import { levels, postmortems, concepts, u, pad, assistKind, GROUP_ORDER } from '../lib/site';

const zy = levels.find((l) => l.slug === 'zygpt');
const groups = GROUP_ORDER.map((g) => ({ g, n: concepts.filter((c) => c.group === g).length })).filter((x) => x.n > 0);
const lessons = [
  {
    t: 'Take the artifact at its word',
    d: 'ZyGPT recited exactly where its flag was hidden, and for days my AI sessions and I treated that as a trap. Believing it is what solved it.',
  },
  {
    t: 'Use AI to learn, then decide yourself',
    d: 'Nintendo DS save files and Windows PE headers were completely new to me on Levels 5 and 6. Claude and ChatGPT got me up to speed quickly, and I decided for myself what mattered.',
  },
  {
    t: 'Decoys are aimed at you, and at your AI',
    d: 'There were fake flags in binaries, strings telling the reader to stop looking, and a Ditto nicknamed "NOT ME!". I stopped counting anything until the challenge itself confirmed it.',
  },
  {
    t: 'Run a positive control before trusting a null',
    d: 'A negative result only means something if the method can find a planted positive. I learned that in psychology coursework, and it is what made my final ZyGPT search trustworthy.',
  },
];
---
<Base title="Home" current="home" sidebar={false}>
  <div class="home">
    <section class="hero">
      <p class="kicker">TISC 2026 · The InfoSecurity Challenge · Levels 1–7</p>
      <h1>A psychology student against seven levels of misdirection.</h1>
      <p class="hero-lede">
        I'm <strong>Elodie Ng</strong>. I study psychology, and programming is not my strength. These are my writeups
        for the first seven levels of TISC 2026, with the dead ends left in. I used AI heavily, and each page
        says how.
      </p>
      <div class="hero-actions">
        {zy && <a class="btn primary" href={zy.url}>Start with ZyGPT, the six-day one <span aria-hidden="true">→</span></a>}
        <a class="btn" href="#levels">Browse all levels</a>
        <a class="btn" href={u('about/')}>How I used AI</a>
      </div>
    </section>

    {zy && (
      <section class="feature" aria-labelledby="feature-h">
        <div class="feature-copy">
          <p class="kicker">Featured case · Level 04</p>
          <h2 id="feature-h">ZyGPT: the flag was sitting in the weights</h2>
          <p>
            A fine-tuned chatbot told me, in detail, how its flag was encrypted into its own weights. I spent six days
            and twelve AI-assisted sessions treating that as a lie. I tried prefill attacks, Chinese-language prompts,
            user-persona sampling, gradient soft prompts and logit lenses, and ran a 350-call study that I wrote up like
            a psychology paper. The model never knew the flag. Its ciphertext sat in 608 low bits of one weight matrix,
            and I only found it once I read the model's description as an honest spec.
          </p>
          <div class="feature-actions">
            <a class="btn primary" href={zy.url}>Read the solution</a>
            {zy.workings && <a class="btn" href={u(zy.workings)}>Read the workings</a>}
          </div>
        </div>
        <dl class="feature-facts">
          <div><dt>350</dt><dd>extraction attempts across 70 strategies, zero real flags</dd></div>
          <div><dt>11.2M × 84</dt><dd>candidate keys × carrier tensors in the final search</dd></div>
          <div><dt>~30 min</dt><dd>for that search on a CPU laptop, with AES-GCM as the judge</dd></div>
        </dl>
      </section>
    )}

    <section id="levels" class="home-section" aria-labelledby="levels-h">
      <div class="section-head">
        <h2 id="levels-h">The levels</h2>
        <p class="legend">
          <span class="chip ai">AI-assisted</span>
          <span class="chip human">Human-led, AI as tooling</span>
        </p>
      </div>
      <ol class="level-rows">
        {levels.map((l) => (
          <li>
            <a class="level-row" href={l.url}>
              <span class="row-num">{pad(l.level)}</span>
              <span class="row-main">
                <span class="row-title">{l.title}</span>
                <span class="row-summary">{l.summary}</span>
              </span>
              <span class="row-meta">
                <span class="row-cat">{l.category}</span>
                <span class:list={['chip', assistKind(l)]}>{assistKind(l) === 'human' ? 'Human-led' : 'AI-assisted'}</span>
                {l.workings && <span class="chip accent">+ workings</span>}
              </span>
              <span class="row-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </section>

    {postmortems.length > 0 && (
      <section class="home-section" aria-labelledby="pm-h">
        <div class="section-head"><h2 id="pm-h">The one that got away</h2></div>
        {postmortems.map((p) => (
          <a class="pm-card" href={p.url}>
            <span class="kicker">Post-mortem · {p.challenge}</span>
            <strong>{p.title}</strong>
            <span class="pm-sum">{p.summary}</span>
            <span class="pm-go">Read the post-mortem <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </section>
    )}

    <section class="home-section split" aria-labelledby="ai-h">
      <div>
        <h2 id="ai-h">How the work was split</h2>
        <p class="muted">
          AI did a lot of the typing and the background reading. The thinking was more mixed. On ZyGPT it spent days
          arguing that the challenge was a trap.
        </p>
        <a class="text-link" href={u('about/')}>The full account →</a>
      </div>
      <div class="split-cards">
        <div class="split-card">
          <span class="chip ai">Levels 1–3</span>
          <h3>AI-assisted</h3>
          <p>The AI did most of the work on the forensics, OSINT, WebAssembly and RSA. I directed it, checked each step and wrote it up.</p>
        </div>
        <div class="split-card">
          <span class="chip human">Levels 4–7</span>
          <h3>Human-led, AI as tooling</h3>
          <p>These needed judgement calls the AI kept missing. I used AI to get up to speed on DS save files, PE headers and a race-condition exploit, but I made the decisions.</p>
        </div>
      </div>
    </section>

    <section class="home-section" aria-labelledby="lessons-h">
      <h2 id="lessons-h">What I'd tell myself on day one</h2>
      <div class="lessons">
        {lessons.map((x, i) => (
          <article class="lesson">
            <span class="lesson-n">{i + 1}</span>
            <h3>{x.t}</h3>
            <p>{x.d}</p>
          </article>
        ))}
      </div>
    </section>

    {concepts.length > 0 && (
      <section class="home-section concepts-teaser" aria-labelledby="concepts-h">
        <div>
          <h2 id="concepts-h">{concepts.length} concepts, explained plainly</h2>
          <p class="muted">Every technique on the site, from prefill attacks to Rich headers, explained for someone technical who is new to CTFs.</p>
        </div>
        <div class="chip-row">
          {groups.map((x) => <a class="chip" href={u(`concepts/#group-${x.g.toLowerCase().replace(/[^a-z]+/g, '-')}`)}>{x.g} · {x.n}</a>)}
        </div>
        <a class="btn" href={u('concepts/')}>Open the glossary</a>
      </section>
    )}
  </div>
</Base>

<style>
  .home { max-width: 1120px; margin-inline: auto; padding-block: 24px 40px; }
  .hero { padding-block: clamp(32px, 6vw, 72px) 40px; max-width: 880px; }
  .hero .kicker { margin: 0 0 18px; }
  .hero h1 { font-size: var(--step-4); font-weight: 800; margin: 0 0 22px; line-height: 1.05; letter-spacing: -0.03em; }
  .hero-lede { font-size: var(--step-1); line-height: 1.55; color: var(--ink-2); margin: 0 0 28px; max-width: 62ch; }
  .hero-lede strong { color: var(--ink); }
  .hero-actions, .feature-actions { display: flex; flex-wrap: wrap; gap: 10px; }

  .feature {
    display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 0;
    border-radius: 16px; overflow: hidden; background: var(--ink); color: var(--bg);
    margin-block: 16px 72px;
  }
  .feature-copy { padding: clamp(24px, 4vw, 44px); min-width: 0; }
  .feature .kicker { color: inherit; opacity: 0.65; margin: 0 0 14px; }
  .feature h2 { font-size: var(--step-3); margin: 0 0 16px; font-weight: 800; }
  .feature p { color: inherit; opacity: 0.86; margin: 0 0 24px; max-width: 60ch; }
  .feature .btn { background: transparent; color: var(--bg); border-color: color-mix(in srgb, var(--bg) 35%, transparent); }
  .feature .btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .feature .btn:hover { border-color: var(--bg); }
  .feature-facts {
    margin: 0; padding: clamp(24px, 4vw, 44px); display: grid; align-content: center; gap: 22px;
    background: color-mix(in srgb, var(--bg) 8%, var(--ink));
    border-left: 1px solid color-mix(in srgb, var(--bg) 14%, transparent);
  }
  .feature-facts dt { font: 700 var(--step-2)/1 var(--mono); color: var(--accent); letter-spacing: -0.02em; }
  .feature-facts dd { margin: 6px 0 0; font-size: 0.92rem; opacity: 0.8; line-height: 1.45; }
  @media (max-width: 820px) {
    .feature { grid-template-columns: 1fr; }
    .feature-facts { border-left: 0; border-top: 1px solid color-mix(in srgb, var(--bg) 14%, transparent); }
  }

  .home-section { margin-block: 0 72px; }
  .home-section h2 { font-size: var(--step-3); font-weight: 800; margin: 0 0 12px; }
  .section-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 12px; margin-bottom: 18px; }
  .section-head h2 { margin: 0; }
  .legend { display: flex; gap: 6px; margin: 0; flex-wrap: wrap; }
  .muted { color: var(--ink-2); margin: 0 0 14px; max-width: 58ch; }
  .text-link { font-weight: 700; text-decoration: none; }

  .level-rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--rule); }
  .level-row {
    display: grid; grid-template-columns: 56px minmax(0, 1fr) auto 24px; gap: 18px; align-items: center;
    padding: 18px 12px; border-bottom: 1px solid var(--rule);
    color: var(--ink); text-decoration: none; transition: background 0.15s;
  }
  .level-row:hover { background: var(--surface); }
  .level-row:hover .row-arrow { color: var(--accent); transform: translateX(3px); }
  .row-num { font: 700 var(--step-2)/1 var(--mono); color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .level-row:hover .row-num { color: var(--accent); }
  .row-main { min-width: 0; display: grid; gap: 4px; }
  .row-title { font: 700 var(--step-1)/1.2 var(--display); }
  .row-summary { color: var(--ink-2); font-size: 0.95rem; line-height: 1.45; }
  .row-meta { display: flex; flex-wrap: wrap; gap: 6px; justify-content: flex-end; align-items: center; max-width: 280px; }
  .row-cat { font: 600 0.75rem/1 var(--mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-3); width: 100%; text-align: right; margin-bottom: 2px; }
  .row-arrow { font: 400 1.2rem/1 var(--mono); color: var(--ink-3); transition: transform 0.15s, color 0.15s; }
  @media (max-width: 720px) {
    .level-row { grid-template-columns: 40px minmax(0, 1fr); gap: 8px 12px; padding: 16px 4px; }
    .row-meta { grid-column: 2; justify-content: flex-start; max-width: none; }
    .row-cat { text-align: left; }
    .row-arrow { display: none; }
    .row-num { font-size: var(--step-1); }
  }

  .pm-card {
    display: grid; gap: 8px; padding: 22px 24px; border-radius: 16px; text-decoration: none; color: var(--ink);
    border: 1px dashed var(--accent); background: var(--accent-soft);
  }
  .pm-card:hover { background: var(--surface); }
  .pm-card strong { font: 800 var(--step-2)/1.15 var(--display); }
  .pm-sum { color: var(--ink-2); max-width: 70ch; }
  .pm-go { font-weight: 700; color: var(--accent); }
  .split { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr); gap: 32px; align-items: start; }
  .split-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .split-card { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--radius); padding: 20px; min-width: 0; }
  .split-card h3 { font-size: var(--step-1); margin: 12px 0 8px; }
  .split-card p { margin: 0; color: var(--ink-2); font-size: 0.95rem; }
  @media (max-width: 820px) { .split { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .split-cards { grid-template-columns: 1fr; } }

  .lessons { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; margin-top: 18px; }
  .lesson { padding: 22px; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--surface); min-width: 0; }
  .lesson-n { font: 700 0.8rem/1 var(--mono); color: var(--accent); }
  .lesson h3 { font-size: var(--step-1); margin: 10px 0 8px; }
  .lesson p { margin: 0; color: var(--ink-2); font-size: 0.97rem; }
  @media (max-width: 640px) { .lessons { grid-template-columns: 1fr; } }

  .concepts-teaser { display: grid; gap: 16px; justify-items: start; padding: 28px; border-radius: 16px; background: var(--surface-2); }
  .concepts-teaser .muted { margin: 0; }
</style>
